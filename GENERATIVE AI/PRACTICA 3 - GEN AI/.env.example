# Región donde tengas acceso a los modelos
AWS_REGION=us-east-1

# Puedes sustituirlos por otros modelos disponibles en tu cuenta/región
CLAUDE_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
IMAGE_MODEL_ID=stability.sd3-5-large-v1:0

# OPCIÓN A: credenciales habituales de AWS CLI / IAM
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# OPCIÓN B: si tu cuenta usa una API key de Amazon Bedrock
# AWS_BEARER_TOKEN_BEDROCK=
